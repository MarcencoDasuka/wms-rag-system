# ========================================================
# Warehouse Management System (WMS) - Environment Template
# ========================================================
# Copy this file to .env and replace placeholder values with your real secrets:
#   cp .env.example .env
# WARNING: NEVER commit the actual .env file to version control!

# --- PostgreSQL Database ---
POSTGRES_DB=wms_db
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/wms_db
DB_USERNAME=wms_user
DB_PASSWORD=your_secure_db_password

# --- Flyway Migrations ---
FLYWAY_URL=jdbc:postgresql://localhost:5432/wms_db
FLYWAY_USER=wms_user
FLYWAY_PASSWORD=your_secure_db_password

# --- Security & JWT (Must be at least 256-bit / 32 characters) ---
JWT_SECRET=your_secure_random_256bit_hmac_sha_secret_key_here

# --- Mail / SMTP Server ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_email@gmail.com

# --- Application URLs ---
WMS_APP_URL=http://localhost:8080
WMS_FRONTEND_URL=http://localhost:5173

# --- External AI APIs (Optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
